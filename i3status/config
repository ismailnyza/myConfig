general {
    colors = true
    interval = 5
    color_good = "#a6e3a1"
    color_degraded = "#f9e2af"
    color_bad = "#f38ba8"
}

order += "wireless _first_"
order += "ethernet _first_"
order += "battery all"
order += "volume master"
order += "tztime local"

wireless _first_ {
    format_up = "W: %essid (%quality)"
    format_down = "W: down"
}

ethernet _first_ {
    format_up = "E: up"
    format_down = "E: down"
}

battery all {
    format = "%status %percentage %remaining"
    format_down = "No battery"
    status_chr = "CHG"
    status_bat = "BAT"
    status_unk = "?"
    status_full = "FULL"
    low_threshold = 20
}

volume master {
    format = "VOL %volume"
    format_muted = "VOL muted"
    device = "default"
    mixer = "Master"
    mixer_idx = 0
}

tztime local {
    format = "%Y-%m-%d %H:%M"
}
