set $mod Mod4
set $terminal alacritty
set $launcher rofi -show drun
set $browser sh -c "command -v brave-browser >/dev/null && exec brave-browser || exec xdg-open https://google.com"
set $editor alacritty -e nvim
set $filemanager thunar
set $lock i3lock

font pango:JetBrainsMono Nerd Font 10
floating_modifier $mod
focus_follows_mouse no
mouse_warping none

# Gaps / borders
for_window [class=".*"] border pixel 2
hide_edge_borders none

# Autostart
exec_always --no-startup-id pkill -x dunst; dunst
exec_always --no-startup-id sh -c "[ -f ~/Pictures/wallpaper.png ] && feh --bg-fill ~/Pictures/wallpaper.png"
exec_always --no-startup-id sh -c "pgrep -x nm-applet >/dev/null || nm-applet"

# Bar
bar {
    status_command i3status -c ~/.config/i3status/config
    position top
    tray_output primary
    colors {
        background #1e1e2e
        statusline #cdd6f4
        separator  #45475a
        focused_workspace  #cba6f7 #cba6f7 #11111b
        active_workspace   #313244 #313244 #cdd6f4
        inactive_workspace #1e1e2e #1e1e2e #6c7086
        urgent_workspace   #f38ba8 #f38ba8 #11111b
    }
}

# Core apps
bindsym $mod+Return exec $terminal
bindsym $mod+d exec $launcher
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'Exit i3?' -B 'Yes' 'i3-msg exit'"
bindsym $mod+Shift+r restart
bindsym $mod+Shift+c reload
bindsym $mod+q kill
bindsym $mod+f fullscreen toggle
bindsym $mod+space floating toggle
bindsym $mod+Shift+space focus mode_toggle
bindsym $mod+e exec $filemanager
bindsym $mod+b exec $browser
bindsym $mod+n exec $editor
bindsym $mod+Shift+l exec $lock

# Movement
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
# $mod+Shift+l reserved for lock

# Split / layout
bindsym $mod+v split v
bindsym $mod+s split h
bindsym $mod+w layout tabbed
bindsym $mod+r layout toggle split
bindsym $mod+Shift+f floating toggle

# Workspaces
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# Resize mode
mode "resize" {
    bindsym h resize shrink width 10 px or 10 ppt
    bindsym j resize grow height 10 px or 10 ppt
    bindsym k resize shrink height 10 px or 10 ppt
    bindsym l resize grow width 10 px or 10 ppt

    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym $mod+r mode "default"
}
bindsym $mod+Shift+x mode "resize"

# Screenshots
bindsym Print exec --no-startup-id sh -c 'mkdir -p ~/Pictures/screenshots && file=~/Pictures/screenshots/$(date +%Y-%m-%d-%H%M%S)-screenshot.png && scrot "$file" && notify-send "Screenshot saved" "$file"'
bindsym $mod+Print exec --no-startup-id sh -c 'mkdir -p ~/Pictures/screenshots && file=~/Pictures/screenshots/$(date +%Y-%m-%d-%H%M%S)-selection.png && scrot -s "$file" && notify-send "Screenshot saved" "$file"'

# Media / brightness
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +5%
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle
bindsym XF86MonBrightnessUp exec --no-startup-id brightnessctl set +10%
bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl set 10%-

# Window rules
for_window [class="Pavucontrol"] floating enable
for_window [class="Blueman-manager"] floating enable
for_window [window_role="pop-up"] floating enable

# Better defaults for dialogs
assign [class="^Brave-browser$"] $ws2
for_window [class="^Thunar$"] floating disable
for_window [class="^Nm-connection-editor$"] floating enable
